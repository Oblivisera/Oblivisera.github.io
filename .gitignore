# 依赖与构建产物
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Obsidian 仓库配置。
# 里面是本地编辑器状态（workspace.json 每次开关都会变）和插件的
# 1MB 编译产物，与博客内容无关，而且它在 docs/ 之外，不会被发布。
# 如果你希望多台设备通过这个仓库同步 Obsidian 设置，
# 删掉这一行，并单独忽略 workspace.json 即可。
.obsidian/

# 环境变量
.env
.env.local
.env.*.local
