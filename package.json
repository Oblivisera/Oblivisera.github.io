{
  "name": "oblivisera-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Oblivisera 的个人博客，基于 VitePress 构建",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "new": "node scripts/new-post.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "verify": "npm run build && npm run check:links && npm run check:search && npm run check:pages"
  },
  "devDependencies": {
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.1.0",
    "vitepress": "^1.6.4"
  }
}
